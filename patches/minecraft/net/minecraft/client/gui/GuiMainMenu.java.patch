+    private static class GlitchHelper {
+        private static final Random rand = new Random();
+        private static final String GLITCH_CHARS =
+                "\u2591\u2592\u2593\u220F\u2310\u255A\u2554\u2569\u2566\u2560\u2550\u256C\u258C\u2590\u2588\u25A0\u00BF\u240D\u2320\u255E\u2584\u2580";
+
+        private static GlitchRecord[] records = new GlitchRecord[0];
+        private static String lastOriginal = null;
+
+        public static String glitchText(String original) {
+            if (original == null) {
+                return null;
+            }
+
+            // Check if the original string has changed since the last call
+            if (lastOriginal == null || !original.equals(lastOriginal)) {
+                records = new GlitchRecord[original.length()];
+                lastOriginal = original;
+            }
+
+            char[] chars = original.toCharArray();
+            long currentTime = System.currentTimeMillis();
+
+            for (int i = 0; i < chars.length; i++) {
+                GlitchRecord record = records[i];
+                if (record != null) {
+                    long elapsed = currentTime - record.timestamp;
+                    if (elapsed < 300) {
+                        chars[i] = record.replacement;
+                        continue;
+                    } else {
+                        records[i] = null;
+                    }
+                }
+
+                if (rand.nextFloat() < 0.05f) {
+                    char glitchChar = GLITCH_CHARS.charAt(rand.nextInt(GLITCH_CHARS.length()));
+                    chars[i] = glitchChar;
+                    records[i] = new GlitchRecord(glitchChar, currentTime);
+                }
+            }
+
+            return new String(chars);
+        }
+
+        private static class GlitchRecord {
+            char replacement;
+            long timestamp;
+
+            GlitchRecord(char replacement, long timestamp) {
+                this.replacement = replacement;
+                this.timestamp = timestamp;
+            }
+        }
+    }
